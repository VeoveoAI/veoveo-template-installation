#!/bin/sh
# Native user auth/checkout composition; no Hub/operator credentials are read.
set -eu
umask 077
export HOME=/sandbox/home
export XDG_CONFIG_HOME=/sandbox/home/.config
export XDG_DATA_HOME=/sandbox/home/.local/share
export XDG_STATE_HOME=/sandbox/home/.local/state
export XDG_CACHE_HOME=/sandbox/home/.cache
export LORE_GLOBAL_PATH=/sandbox/home/.local/share/lore
export LORE_AUTH_PATH=/sandbox/home/.config/lore/auth
export NO_COLOR=1
export SSL_CERT_DIR=/etc/ssl/certs

case "${1:-}" in
  '') login=true ;;
  --retry) login=false ;;
  *) echo 'Usage: computer-workspace [--retry]' >&2; exit 3 ;;
esac
[ "$#" -le 1 ] || exit 3
file=/sandbox/home/.config/computer/workspace.env
if [ ! -f "$file" ]; then
  echo 'Personal workspace preparation is pending; reopen /computer to retry.' >&2
  exit 75
fi
# Hub emits exactly these three safely quoted public assignments. No executable,
# destination, token, or command is supplied by the descriptor.
. "$file"
: "${COMPUTER_WORKSPACE_REMOTE:?missing native workspace URL}"
: "${COMPUTER_WORKSPACE_REPOSITORY:?missing native repository ID}"
: "${COMPUTER_WORKSPACE_BRANCH:?missing native branch ID}"
for id in "$COMPUTER_WORKSPACE_REPOSITORY" "$COMPUTER_WORKSPACE_BRANCH"; do
  case "$id" in *[!0-9a-f]*|'') exit 3 ;; esac
  [ "${#id}" -eq 32 ] || exit 3
done
case "$COMPUTER_WORKSPACE_REMOTE" in
  grpcs://*/"$COMPUTER_WORKSPACE_REPOSITORY") ;;
  *) echo 'Invalid native workspace descriptor.' >&2; exit 3 ;;
esac
if "$login"; then
  /usr/local/bin/lore auth login "$COMPUTER_WORKSPACE_REMOTE" --no-browser
fi

destination=/sandbox/projects/workspace
verify_checkout() {
  # Native config and native repository metadata decide identity. Do not infer it
  # from the directory name or replace a user's unrelated/modified checkout.
  [ ! -L "$destination" ] && [ -d "$destination/.lore" ] || return 73
  remote=$(/usr/local/bin/lore -P --repository "$destination" repository config get remote_url) || return "$?"
  [ "$remote/$COMPUTER_WORKSPACE_REPOSITORY" = "$COMPUTER_WORKSPACE_REMOTE" ] || return 73
  info=$(/usr/local/bin/lore -P --repository "$destination" --local repository info) || return "$?"
  first=$(printf '%s\n' "$info" | sed -n '1p')
  case "$first" in *" ($COMPUTER_WORKSPACE_REPOSITORY)") ;; *) return 73 ;; esac
  # Remote metadata checks the current native user grant; local files alone are
  # never reported as authenticated. This also uses native refresh when needed.
  /usr/local/bin/lore -P --repository "$destination" repository info >/dev/null
}
if [ -e "$destination" ] || [ -L "$destination" ]; then
  if verify_checkout; then
    printf 'Personal workspace ready: %s (%s)\n' "$destination" "$COMPUTER_WORKSPACE_REPOSITORY"
    exit 0
  else
    code=$?
    if [ "$code" -eq 73 ]; then echo 'Personal workspace destination belongs to a different checkout; left unchanged.' >&2; fi
    exit "$code"
  fi
fi

mkdir -p /sandbox/projects
staging=$(mktemp -d /sandbox/projects/.computer-workspace.XXXXXX)
trap 'rm -rf "$staging"' EXIT HUP INT TERM
# Native --branch is exactly <branch-id>@latest. The source repository and branch
# identities come from the verified native response, never a display-name lookup.
/usr/local/bin/lore clone "$COMPUTER_WORKSPACE_REMOTE" "$staging/checkout" --branch "$COMPUTER_WORKSPACE_BRANCH"
# GNU coreutils in the Computer image: do not replace even an empty directory
# created by a competing invocation or by the user.
mv -T --no-clobber "$staging/checkout" "$destination"
[ ! -e "$staging/checkout" ] || exit 75
verify_checkout
printf 'Personal workspace ready: %s (%s)\n' "$destination" "$COMPUTER_WORKSPACE_REPOSITORY"
