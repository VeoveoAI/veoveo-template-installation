{
  "model": "deepinfra/XiaomiMiMo/MiMo-V2.6-Pro",
  "default_agent": "build",
  "update": "disable",
  "share": "disabled",
  "warming": false,
  "snapshots": false,
  "plugins": [
    "-opencode.vcs.git",
    "-opencode.vcs.hg",
    "-opencode.provider.ollama",
    "-opencode.provider.lmstudio",
    "-opencode.provider.vllm",
    "-opencode.provider.opencode"
  ],
  "policies": [
    {"action": "provider.use", "resource": "*", "effect": "deny"},
    {"action": "provider.use", "resource": "deepinfra", "effect": "allow"},
    {"action": "provider.use", "resource": "anthropic", "effect": "allow"}
  ],
  "providers": {
    "deepinfra": {
      "settings": {"apiKey": "{env:DEEPINFRA_API_KEY}"}
    },
    "anthropic": {
      "settings": {"apiKey": "{env:ANTHROPIC_API_KEY}"},
      "models": {
        "claude-fable-5": {"disabled": true},
        "claude-haiku-4-5": {"disabled": true},
        "claude-haiku-4-5-20251001": {"disabled": true},
        "claude-opus-4-5": {"disabled": true},
        "claude-opus-4-5-20251101": {"disabled": true},
        "claude-opus-4-6": {"disabled": true},
        "claude-opus-4-7": {"disabled": true},
        "claude-opus-4-8": {"disabled": true},
        "claude-opus-5": {"disabled": true},
        "claude-sonnet-4-5": {"disabled": true},
        "claude-sonnet-4-5-20250929": {"disabled": true},
        "claude-sonnet-4-6": {"disabled": true},
        "claude-sonnet-5": {"disabled": true}
      }
    }
  },
  "mcp": {
    "servers": {
      "hub": {
        "type": "remote",
        "url": "{env:COMPUTER_HUB_URL}",
        "protocol": "2026-07-28",
        "oauth": false,
        "headers": {"Authorization": "Bearer {env:COMPUTER_HUB_REFERENCE}"},
        "skills": {
          "approved": ["skill://veoveo/", "skill://console/", "skill://artifact/", "skill://media/", "skill://embedding/"]
        }
      }
    }
  }
}
