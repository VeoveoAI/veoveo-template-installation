{
  "kubernetes": {
    "volumes": [
      {
        "name": "state",
        "persistent_volume_claim": {
          "claim_name": "embedding-state-v1",
          "read_only": false
        }
      },
      {
        "name": "postgres-ca",
        "persistent_volume_claim": {
          "claim_name": "postgres-client-ca-v1",
          "read_only": true
        }
      }
    ],
    "containers": {
      "agent": {
        "volume_mounts": [
          {
            "name": "state",
            "mount_path": "/var/lib/veoveo/embedding",
            "read_only": false
          },
          {
            "name": "postgres-ca",
            "mount_path": "/etc/veoveo/tls",
            "read_only": true
          }
        ],
        "resources": {
          "requests": {
            "cpu": "0",
            "memory": "0"
          },
          "limits": {
            "cpu": "1",
            "memory": "1Gi"
          }
        }
      }
    }
  }
}
