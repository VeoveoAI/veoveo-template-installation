{
  "kubernetes": {
    "volumes": [
      {
        "name": "postgres-ca",
        "persistent_volume_claim": {
          "claim_name": "postgres-client-ca-v1",
          "read_only": true
        }
      }
    ],
    "containers": {
      "agent": {
        "volume_mounts": [
          {
            "name": "postgres-ca",
            "mount_path": "/etc/veoveo/tls",
            "read_only": true
          }
        ]
      }
    }
  }
}
