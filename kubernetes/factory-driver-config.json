{
  "kubernetes": {
    "volumes": [
      {
        "name": "lore",
        "image": {
          "reference": "@image:lore@"
        }
      }
    ],
    "containers": {
      "agent": {
        "volume_mounts": [
          {
            "name": "lore",
            "mount_path": "/opt/veoveo/lore",
            "read_only": true
          }
        ],
        "resources": {
          "requests": {
            "cpu": "0",
            "memory": "0"
          },
          "limits": {
            "cpu": "4",
            "memory": "8Gi"
          }
        }
      }
    }
  }
}
