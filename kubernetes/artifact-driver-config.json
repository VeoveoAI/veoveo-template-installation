{
  "kubernetes": {
    "volumes": [
      {
        "name": "state",
        "persistent_volume_claim": {
          "claim_name": "artifact-state-v1",
          "read_only": false
        }
      },
      {
        "name": "config",
        "persistent_volume_claim": {
          "claim_name": "artifact-config-v1",
          "read_only": true
        }
      },
      {
        "name": "postgres-ca",
        "persistent_volume_claim": {
          "claim_name": "postgres-client-ca-v1",
          "read_only": true
        }
      }
    ],
    "containers": {
      "agent": {
        "volume_mounts": [
          {
            "name": "state",
            "mount_path": "/var/lib/veoveo/artifact",
            "read_only": false
          },
          {
            "name": "config",
            "mount_path": "/etc/veoveo/artifact",
            "read_only": true
          },
          {
            "name": "postgres-ca",
            "mount_path": "/etc/veoveo/tls",
            "read_only": true
          }
        ]
      }
    }
  }
}
