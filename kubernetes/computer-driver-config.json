{
  "kubernetes": {
    "volumes": [
      {
        "name": "lore",
        "image": {
          "reference": "@image:lore@"
        }
      },
      {
        "name": "hub-sdk-cli",
        "image": {
          "reference": "@image:hub-sdk-cli@"
        }
      }
    ],
    "containers": {
      "agent": {
        "volume_mounts": [
          {
            "name": "lore",
            "mount_path": "/opt/veoveo/lore",
            "read_only": true
          },
          {
            "name": "hub-sdk-cli",
            "mount_path": "/opt/veoveo/hub-sdk-cli",
            "read_only": true
          }
        ],
        "resources": {
          "requests": {
            "cpu": "0",
            "memory": "0"
          },
          "limits": {
            "cpu": "2",
            "memory": "4Gi"
          }
        }
      }
    }
  }
}
