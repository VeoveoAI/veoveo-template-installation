def private(path, text, exclusive=False):
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    path.parent.chmod(0o700)
    if exclusive:
        descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(descriptor, 'w') as output:
            output.write(text)
    else:
        with tempfile.NamedTemporaryFile(mode='w', dir=path.parent, delete=False) as output:
            temporary = Path(output.name)
            output.write(text)
        temporary.chmod(0o600)
        temporary.replace(path)
    path.chmod(0o600)


def environment(values):
    return ''.join(name + '=' + shlex.quote(value) + '\n' for name, value in values.items())


def hub_secrets(origin, hosted=False):
    path = STATE / 'hub.env'
    required = ['VEOVEO_FORWARDED_TOKEN_KEY_B64', 'VEOVEO_AUDIT_SIGNING_KEY_B64',
                'VEOVEO_REFRESH_DELIVERY_KEY_B64', 'VEOVEO_REGISTRATION_SECRET', 'VEOVEO_DATABASE_PASSWORD']
    if hosted:
        required += ['VEOVEO_ACCESS_TOKEN_SIGNING_KEY_B64', 'VEOVEO_IDP_OIDC_CLIENT_SECRET']
    if path.exists():
        values = {}
        for line in path.read_text().splitlines():
            name, separator, value = line.partition('=')
            if not separator or name in values:
                raise ValueError('invalid retained Hub environment')
            parsed = shlex.split(value)
            if len(parsed) != 1:
                raise ValueError('invalid retained Hub environment value')
            values[name] = parsed[0]
        if any(not values.get(name) for name in required) or values.get('VEOVEO_ISSUER') != origin:
            raise ValueError('recover existing Hub state; do not replace missing keys or change its origin')
        supplied = os.environ.get('VEOVEO_DATABASE_PASSWORD')
        if supplied is not None and supplied != values['VEOVEO_DATABASE_PASSWORD']:
            raise ValueError('database credential differs; perform reviewed database rotation separately')
        if hosted and os.environ.get('VEOVEO_IDP_OIDC_CLIENT_SECRET') != values['VEOVEO_IDP_OIDC_CLIENT_SECRET']:
            raise ValueError('Entra credential differs; perform reviewed rotation separately')
        path.chmod(0o600)
        return values
    password = os.environ.get('VEOVEO_DATABASE_PASSWORD')
    if not password or '\n' in password or '\r' in password:
        raise ValueError('first preparation requires VEOVEO_DATABASE_PASSWORD from trusted bootstrap')
    # The Hub's own Ed25519 PKCS#8 key, not a caller or IdP signing key.
    key = subprocess.run(['openssl', 'genpkey', '-algorithm', 'Ed25519', '-outform', 'DER'],
                         check=True, capture_output=True).stdout
    values = {
        'VEOVEO_FORWARDED_TOKEN_KEY_B64': base64.b64encode(key).decode(),
        'VEOVEO_AUDIT_SIGNING_KEY_B64': base64.b64encode(secrets.token_bytes(32)).decode(),
        'VEOVEO_REFRESH_DELIVERY_KEY_B64': base64.b64encode(secrets.token_bytes(32)).decode(),
        'VEOVEO_REGISTRATION_SECRET': secrets.token_urlsafe(32),
        'VEOVEO_DATABASE_PASSWORD': password,
        'VEOVEO_DATABASE_URL': 'postgres://veoveo_owner@host.openshell.internal:5432/veoveo',
        'VEOVEO_SERVER_DATABASE_URL': 'postgres://host.openshell.internal:5432/veoveo',
        'VEOVEO_ISSUER': origin, 'VEOVEO_CONFIG': '/etc/veoveo/hub/hub.json',
        'VEOVEO_LISTEN_ADDRESS': '127.0.0.1:8080',
    }
    if hosted:
        secret = os.environ.get('VEOVEO_IDP_OIDC_CLIENT_SECRET', '')
        if not secret.strip() or '\n' in secret or '\r' in secret:
            raise ValueError('Entra preparation requires its confidential client secret in the trusted environment')
        signing = subprocess.run(['openssl', 'genpkey', '-algorithm', 'Ed25519', '-outform', 'DER'],
                                 check=True, capture_output=True).stdout
        values['VEOVEO_ACCESS_TOKEN_SIGNING_KEY_B64'] = base64.b64encode(signing).decode()
        values['VEOVEO_IDP_OIDC_CLIENT_SECRET'] = secret
    private(path, environment(values), exclusive=True)
    return values


def claim(name, value, kind='String'):
    return {'name': name, 'protocol': 'openid-connect', 'protocolMapper': 'oidc-hardcoded-claim-mapper',
            'config': {'claim.name': name.replace('.', r'\.'), 'claim.value': value,
                       'jsonType.label': kind, 'access.token.claim': 'true',
                       'id.token.claim': 'false', 'userinfo.token.claim': 'false'}}


def configure_client(request, token, role, scope_id):
    base = '/admin/realms/veoveo'
    client_id = 'vv-hub-' + role
    management = role == 'forwarder'
    matches = request(base + '/clients?clientId=' + client_id, token=token)
    path = STATE / (role + '.secret')
    previous_subject = None
    if matches:
        key = matches[0]['id']
        previous_subject = request(base + '/clients/' + key + '/service-account-user', token=token)['id']
        secret = request(base + '/clients/' + key + '/client-secret', token=token)['value']
        if path.exists() and path.read_text().strip() != secret:
            raise ValueError('retained client secret differs; recover custody before changing the client')
    else:
        secret = path.read_text().strip() if path.exists() else secrets.token_urlsafe(36)
    if not secret:
        raise ValueError('empty retained client secret')
    if not path.exists():
        private(path, secret + '\n', exclusive=True)
    path.chmod(0o600)
    representation = {'clientId': client_id, 'protocol': 'openid-connect', 'enabled': True,
        'publicClient': False, 'clientAuthenticatorType': 'client-secret', 'secret': secret,
        'standardFlowEnabled': False, 'serviceAccountsEnabled': True, 'directAccessGrantsEnabled': False,
        'implicitFlowEnabled': False, 'fullScopeAllowed': False, 'redirectUris': [],
        'attributes': {'access.token.lifespan': '300', 'access.token.header.type.rfc9068': 'true',
                       'client_credentials.use_refresh_token': 'false'}}
    if matches:
        request(base + '/clients/' + key, 'PUT', representation, token)
    else:
        request(base + '/clients', 'POST', representation, token)
        key = request(base + '/clients?clientId=' + client_id, token=token)[0]['id']
    account = request(base + '/clients/' + key + '/service-account-user', token=token)['id']
    if previous_subject is not None and account != previous_subject:
        raise ValueError('service-account subject changed unexpectedly')
    scopes = request(base + '/client-scopes', token=token)
    default = {next(scope['id'] for scope in scopes if scope['name'] == 'basic')}
    if management:
        default.add(next(scope['id'] for scope in scopes if scope['name'] == 'roles'))
    for kind, wanted in [('default', default), ('optional', {scope_id})]:
        link = base + '/clients/' + key + '/' + kind + '-client-scopes'
        present = {scope['id'] for scope in request(link, token=token)}
        for value in present - wanted:
            request(link + '/' + value, 'DELETE', token=token)
        for value in wanted - present:
            request(link + '/' + value, 'PUT', token=token)
    # Dedicated accounts have no inherited default/admin realm grants.
    user_roles = base + '/users/' + account + '/role-mappings/realm'
    current = request(user_roles, token=token)
    if current:
        request(user_roles, 'DELETE', current, token)
    for group in request(base + '/users/' + account + '/groups', token=token):
        request(base + '/users/' + account + '/groups/' + group['id'], 'DELETE', token=token)
    # Restrict client role scope as well as the account's actual role assignment.
    scope_roles = base + '/clients/' + key + '/scope-mappings/realm'
    current = request(scope_roles, token=token)
    if current:
        request(scope_roles, 'DELETE', current, token)
    if management:
        role_definition = request(base + '/roles/openshell-user', token=token)
        if role_definition.get('composite'):
            raise ValueError('openshell-user must not inherit broader realm roles')
        request(user_roles, 'POST', [role_definition], token)
        request(scope_roles, 'POST', [role_definition], token)
        mappers = [claim('openshell_scopes', 'sandbox:write')]
        audience = 'openshell'
    else:
        mappers = [claim('sub', client_id), claim('client_id', client_id),
            claim('https://veoveo.ai/claims/principal', ISSUER + '#' + client_id),
            claim('https://veoveo.ai/claims/principal-kind', 'service'),
            claim('https://veoveo.ai/claims/tenant', 'local'),
            claim('https://veoveo.ai/claims/work-context', 'local'),
            claim('https://veoveo.ai/claims/invocation-mode', 'automated')]
        audience = HUB_ORIGIN + '/mcp/local'
    mappers.append({'name': 'audience', 'protocol': 'openid-connect', 'protocolMapper': 'oidc-audience-mapper',
                    'config': {'included.custom.audience': audience, 'access.token.claim': 'true',
                               'id.token.claim': 'false', 'userinfo.token.claim': 'false'}})
    mapper_path = base + '/clients/' + key + '/protocol-mappers/models'
    current = request(mapper_path, token=token)
    desired_names = {mapper['name'] for mapper in mappers}
    for mapper in current:
        if mapper['name'] not in desired_names:
            request(mapper_path + '/' + mapper['id'], 'DELETE', token=token)
    for mapper in mappers:
        previous = next((value for value in current if value['name'] == mapper['name']), None)
        if previous:
            request(mapper_path + '/' + previous['id'], 'PUT', mapper, token)
        else:
            request(mapper_path, 'POST', mapper, token)
    prefix = 'VV_HUB_' + role.upper()
    private(STATE / (role + '.refresh.env'), environment({prefix + '_CLIENT_ID': client_id,
                                                       prefix + '_CLIENT_SECRET': secret}))
    return account


def retained_catalog():
    path = STATE / 'hub.json'
    return json.loads(path.read_text()) if path.exists() else None


def local_public_catalog(retained, *, client_id, members, context_id, resource, redirects):
    """Add explicit human authority to a fresh catalog; never regenerate its other sections."""
    client_id = identifier(client_id)
    members = sorted({canonical_uuid(member) for member in members})
    redirects = list(dict.fromkeys(redirect_uri(value) for value in redirects))
    resource = https_endpoint(resource)
    if not members or not redirects:
        raise ValueError('local public client requires explicit human IDs and loopback redirects')
    if any(urlsplit(value).scheme != 'http' or urlsplit(value).hostname != '127.0.0.1'
           or urlsplit(value).port is None for value in redirects):
        raise ValueError('native OpenCode requires an explicit HTTP 127.0.0.1 callback port')
    contexts = [context for context in retained['workContexts'] if context['id'] == context_id]
    profiles = [profile for profile in retained['profiles'] if profile['protectedResource'] == resource]
    if len(contexts) != 1 or len(profiles) != 1:
        raise ValueError('select one existing Work Context and MCP resource')
    context, profile = contexts[0], profiles[0]
    servers = [server for server in retained['authorizationServers']
               if server['id'] == profile['authorizationServer'] and server['issuer'] == ISSUER
               and not server.get('accessTokenSigningKey')]
    if len(servers) != 1:
        raise ValueError('local public client requires the existing external Keycloak issuer')
    if not any(role['name'] == 'member' for role in retained['authorization']['roles']):
        raise ValueError('existing member authority is required')
    client = {'id': client_id, 'authorizationServer': profile['authorizationServer'],
        'defaultWorkContext': context_id, 'invocationMode': 'direct', 'allowedResources': [resource],
        'grantTypes': ['authorization_code_pkce', 'refresh_token'], 'authMethods': ['none'],
        'redirectUris': redirects, 'allowedScopes': ['mcp', 'offline_access'],
        'tenant': context['tenant'], 'metadata': {}}
    existing = [value for value in retained['oauthClients'] if value['id'] == client_id]
    if existing and existing != [client]:
        raise ValueError('existing public-client registration differs; review it before replacement')
    result = copy.deepcopy(retained)
    if not existing:
        result['oauthClients'].append(client)
    for member in members:
        grant = {'role': 'member', 'subject': {'principal': member}, 'tenant': context['tenant']}
        if grant not in result['authorization']['grants']:
            result['authorization']['grants'].append(grant)
    selected = next(value for value in result['workContexts'] if value['id'] == context_id)
    contributors = {principal for membership in selected['memberships']
                    if membership['level'] == 'contributor'
                    for principal in membership.get('principals', [])}
    missing = sorted(set(members) - contributors)
    if missing:
        selected['memberships'].append({'level': 'contributor', 'principals': missing})
    return result


def local_public_client(client, context):
    """Native Keycloak public-client representation and built-in claim mappers."""
    resource, = client['allowedResources']
    representation = {'clientId': client['id'], 'protocol': 'openid-connect', 'enabled': True,
        'publicClient': True, 'standardFlowEnabled': True, 'serviceAccountsEnabled': False,
        'directAccessGrantsEnabled': False, 'implicitFlowEnabled': False, 'fullScopeAllowed': False,
        'redirectUris': client['redirectUris'], 'attributes': {
            'pkce.code.challenge.method': 'S256', 'access.token.lifespan': '300',
            'access.token.header.type.rfc9068': 'true', 'use.refresh.tokens': 'true'}}
    mappers = [claim('client_id', client['id']), claim('https://veoveo.ai/claims/principal-kind', 'user'),
        claim('https://veoveo.ai/claims/tenant', context['tenant']),
        claim('https://veoveo.ai/claims/work-context', context['id']),
        claim('https://veoveo.ai/claims/invocation-mode', 'direct')]
    for name in ['principal', 'initiator']:
        mappers.append({'name': name, 'protocol': 'openid-connect',
            'protocolMapper': 'oidc-usermodel-property-mapper', 'config': {'user.attribute': 'id',
                'claim.name': ('https://veoveo.ai/claims/' + name).replace('.', r'\.'),
                'jsonType.label': 'String', 'access.token.claim': 'true',
                'id.token.claim': 'false', 'userinfo.token.claim': 'false'}})
    mappers.append({'name': 'audience', 'protocol': 'openid-connect', 'protocolMapper': 'oidc-audience-mapper',
        'config': {'included.custom.audience': resource, 'access.token.claim': 'true', 'id.token.claim': 'false'}})
    return representation, mappers


def configure_local_public_client(request, token, catalog, client_id):
    """Configure only this public client. No user, role, secret or service-client changes."""
    client, = [value for value in catalog['oauthClients'] if value['id'] == client_id]
    context, = [value for value in catalog['workContexts'] if value['id'] == client['defaultWorkContext']]
    representation, mappers = local_public_client(client, context)
    base = '/admin/realms/veoveo'
    matches = request(base + '/clients?clientId=' + client_id, token=token)
    if len(matches) > 1:
        raise ValueError('ambiguous Keycloak public client')
    if matches and (not matches[0].get('publicClient') or matches[0].get('serviceAccountsEnabled')):
        raise ValueError('refusing to replace a confidential or service-account client')
    scopes = request(base + '/client-scopes', token=token)
    scope_ids = {name: next(scope['id'] for scope in scopes if scope['name'] == name)
                 for name in ['basic', 'mcp', 'offline_access']}
    if matches:
        key = matches[0]['id']
        request(base + '/clients/' + key, 'PUT', representation, token)
    else:
        request(base + '/clients', 'POST', representation, token)
        key = request(base + '/clients?clientId=' + client_id, token=token)[0]['id']
    path = base + '/clients/' + key
    for kind, wanted in [('default', {scope_ids['basic']}),
                         ('optional', {scope_ids['mcp'], scope_ids['offline_access']})]:
        link = path + '/' + kind + '-client-scopes'
        present = {scope['id'] for scope in request(link, token=token)}
        for value in present - wanted:
            request(link + '/' + value, 'DELETE', token=token)
        for value in wanted - present:
            request(link + '/' + value, 'PUT', token=token)
    current = request(path + '/protocol-mappers/models', token=token)
    desired_names = {mapper['name'] for mapper in mappers}
    for mapper in current:
        if mapper['name'] not in desired_names:
            request(path + '/protocol-mappers/models/' + mapper['id'], 'DELETE', token=token)
    for mapper in mappers:
        previous = next((value for value in current if value['name'] == mapper['name']), None)
        if previous:
            request(path + '/protocol-mappers/models/' + previous['id'], 'PUT', mapper, token)
        else:
            request(path + '/protocol-mappers/models', 'POST', mapper, token)


def prepare_local_public(options, root=ROOT):
    """Use trusted operator access; write a candidate for separate native Hub publication."""
    retained = json.loads(Path(options.control_plane_file).read_text())
    prepared = local_public_catalog(retained, client_id=options.application_client_id or 'opencode-local',
        members=options.member_object_id, context_id=options.work_context,
        resource=options.protected_resource, redirects=options.client_redirect_uri)
    request = runpy.run_path(str(root / 'identity/provision'))['request']
    identity = json.loads((root / 'state/identity/credentials.json').read_text())
    token = request('/realms/master/protocol/openid-connect/token', 'POST', {
        'grant_type': 'password', 'client_id': 'admin-cli', 'username': identity['adminUsername'],
        'password': identity['adminPassword']}, form=True)['access_token']
    for member in options.member_object_id:
        user = request('/admin/realms/veoveo/users/' + canonical_uuid(member), token=token)
        if user['id'] != canonical_uuid(member) or not user.get('enabled') or user.get('serviceAccountClientId'):
            raise ValueError('selected member must be an enabled native human user')
    configure_local_public_client(request, token, prepared, options.application_client_id or 'opencode-local')
    private(Path(options.output_control_plane), json.dumps(prepared, indent=2) + '\n')
    print('Prepared native public PKCE client and private catalog candidate; no Hub/runtime publication or login performed.')


def select_services(include_artifact, include_media, retained, include_embedding=False):
    """Preserve approved selections and reject foreign placement before provisioning."""
    if retained is not None:
        bindings = retained['nativeUpstreams']['bindings']
        approved = ([TIME_BINDING], [TIME_BINDING, ARTIFACT_BINDING],
                    [TIME_BINDING, ARTIFACT_BINDING, MEDIA_BINDING])
        approved += tuple(binding + [EMBEDDING_BINDING] for binding in approved)
        if bindings not in approved:
            raise ValueError('existing native bindings differ; review operator placement before regeneration')
        include_artifact = include_artifact or ARTIFACT_BINDING in bindings
        include_media = include_media or MEDIA_BINDING in bindings
        include_embedding = include_embedding or EMBEDDING_BINDING in bindings
    if include_media and not include_artifact:
        raise ValueError('Media requires selected Artifact; use --include-artifact or retain its approved binding')
    return include_artifact, include_media, include_embedding


def catalog(origin, include_artifact=False, include_media=False, retained=None, include_embedding=False):
    include_artifact, include_media, include_embedding = select_services(
        include_artifact, include_media, retained, include_embedding)
    resource = origin + '/mcp/local'
    roles = ['member', 'admin'] + (['billed'] if include_media else [])
    clients = ['vv-hub-' + role for role in roles]
    result = {'identityProviders': [{'id': 'local', 'issuer': ISSUER,
        'jwks': {'source': 'remote', 'jwksUri': JWKS},
        'trustedCertificateAuthorities': [{'source': 'file', 'path': '/etc/veoveo/hub/installation-ca.crt'}],
        'tokenEndpoint': ISSUER + '/protocol/openid-connect/token', 'metadata': {}}],
        'authorizationServers': [{'id': 'local', 'issuer': ISSUER, 'identityProvider': 'local',
            'jwks': {'source': 'remote', 'jwksUri': JWKS},
            'tokenEndpoint': ISSUER + '/protocol/openid-connect/token', 'metadata': {}}],
        'profiles': [{'id': 'local', 'identityProvider': 'local', 'authorizationServer': 'local',
            'protectedResource': resource, 'policyVersion': 'local',
            'authModes': ['oauth_client_credentials'], 'requiredScopes': ['mcp'], 'metadata': {}}],
        'authorization': {'roles': [{'name': 'member', 'access': ['read', 'write']},
            {'name': 'admin', 'access': ['read', 'write'],
             'risks': ['sensitive', 'destructive', 'billed', 'physical', 'administer']}],
            'grants': [{'role': role, 'subject': {'principal': ISSUER + '#vv-hub-' + role}}
                       for role in roles]},
        'registration': {'secret': 'registration_secret'},
        'tenants': [{'id': 'local', 'title': 'Local installation'}],
        'workContexts': [{'id': 'local', 'tenant': 'local', 'title': 'Local', 'policyRevision': 'local',
            'outputPolicy': {'owner': {'kind': 'principal', 'id': ISSUER + '#vv-hub-admin'}},
            'memberships': [{'level': 'contributor', 'oauthClients': clients}]}],
        'policies': [{'version': 'local', 'rules': []}], 'dataLabels': [], 'oidcClients': [],
        'oauthClients': [{'id': client, 'authorizationServer': 'local', 'defaultWorkContext': 'local',
            'invocationMode': 'automated', 'allowedResources': [resource], 'grantTypes': ['client_credentials'],
            'authMethods': ['client_secret_post'], 'allowedScopes': ['mcp'], 'tenant': 'local', 'metadata': {}}
            for client in clients],
        'secrets': [{'id': 'registration_secret', 'source': 'env', 'purpose': 'registration_secret',
            'locator': 'VEOVEO_REGISTRATION_SECRET', 'owner': {'kind': 'hub'}, 'metadata': {}}],
        'nativeUpstreams': {'gateway': 'https://host.openshell.internal:17670',
            'certificateAuthority': '/run/openshell-supervisor-ca/material/ca.crt', 'bearerEnvironment': 'HUB_MANAGEMENT_REFERENCE',
            'bindings': [dict(TIME_BINDING)]}, 'metadata': {}}
    if include_artifact:
        result['nativeUpstreams']['bindings'].append(dict(ARTIFACT_BINDING))
    if include_media:
        result['nativeUpstreams']['bindings'].append(dict(MEDIA_BINDING))
        result['authorization']['roles'].append(
            {'name': 'billed', 'access': ['read', 'write'], 'risks': ['billed']})
    if include_embedding:
        result['nativeUpstreams']['bindings'].append(dict(EMBEDDING_BINDING))
    if retained is not None:
        result['workContexts'] = copy.deepcopy(retained['workContexts'])
        result['policies'] = copy.deepcopy(retained['policies'])
        if include_media:
            contexts = [context for context in result['workContexts']
                        if context['id'] == 'local' and context['tenant'] == 'local']
            if len(contexts) != 1:
                raise ValueError('review retained local Work Context before admitting billed client')
            contributors = [membership for membership in contexts[0]['memberships']
                            if membership['level'] == 'contributor'
                            and {'vv-hub-member', 'vv-hub-admin'}.issubset(membership.get('oauthClients', []))]
            if len(contributors) != 1:
                raise ValueError('review retained contributor membership before admitting billed client')
            if 'vv-hub-billed' not in contributors[0]['oauthClients']:
                contributors[0]['oauthClients'].append('vv-hub-billed')
    return result



def https_origin(value):
    parsed = urlsplit(value)
    if (parsed.scheme != 'https' or not parsed.hostname or parsed.username is not None
            or parsed.password is not None or parsed.path not in ('', '/')
            or parsed.query or parsed.fragment or any(c.isspace() for c in value)):
        raise ValueError('expected an HTTPS origin without credentials, path, query or fragment')
    parsed.port  # Reject malformed/out-of-range ports before any state write.
    return value.rstrip('/')


def https_endpoint(value):
    parsed = urlsplit(value)
    if (parsed.scheme != 'https' or not parsed.hostname or parsed.username is not None
            or parsed.password is not None or parsed.query or parsed.fragment
            or any(c.isspace() for c in value)):
        raise ValueError('expected an HTTPS endpoint without credentials, query or fragment')
    parsed.port
    return value


def identifier(value):
    if not value or any(not (c.isascii() and (c.isalnum() or c in '._-')) for c in value):
        raise ValueError('installation identifiers must be nonempty ASCII names')
    return value


def canonical_uuid(value):
    return str(uuid.UUID(value))


def redirect_uri(value):
    parsed = urlsplit(value)
    if (not parsed.hostname or parsed.username is not None or parsed.password is not None
            or parsed.fragment or any(c.isspace() for c in value)
            or not (parsed.scheme == 'https' or (parsed.scheme == 'http'
                    and parsed.hostname in ('localhost', '127.0.0.1', '::1')))):
        raise ValueError('client redirect requires HTTPS or an HTTP loopback URL, without credentials/fragment')
    parsed.port
    return value


def authorization_jwk(encoded_key):
    """Derive the standard public Ed25519 JWK and RFC 7638 kid; never expose the key."""
    public = subprocess.run(['openssl', 'pkey', '-inform', 'DER', '-pubout', '-outform', 'DER'],
                            input=base64.b64decode(encoded_key, validate=True),
                            check=True, capture_output=True).stdout
    # RFC 8410 Ed25519 SubjectPublicKeyInfo: fixed AlgorithmIdentifier, 32-byte key.
    prefix = bytes.fromhex('302a300506032b6570032100')
    if len(public) != len(prefix) + 32 or not public.startswith(prefix):
        raise ValueError('Hub application signing key must be Ed25519')
    b64 = lambda value: base64.urlsafe_b64encode(value).decode().rstrip('=')
    key = {'crv': 'Ed25519', 'kty': 'OKP', 'x': b64(public[len(prefix):])}
    kid = b64(hashlib.sha256(json.dumps(key, sort_keys=True, separators=(',', ':')).encode()).digest())
    return dict(key, kid=kid, alg='EdDSA', use='sig')


def entra_catalog(origin, discovery, tenant_id, client_id, tenant, context, policy, owner,
                  members, admins, billed, application_client, redirects, gateway, key_id,
                  include_artifact=False, include_media=False, retained=None, include_embedding=False):
    """Render existing Hub/OIDC schemas only. This function has no identity/network I/O."""
    origin, gateway = https_origin(origin), https_origin(gateway)
    tenant_id, client_id = canonical_uuid(tenant_id), canonical_uuid(client_id)
    tenant, context, policy = map(identifier, (tenant, context, policy))
    application_client = identifier(application_client)
    issuer = https_endpoint(discovery['issuer']).rstrip('/')
    if urlsplit(issuer).path != '/' + tenant_id + '/v2.0':
        raise ValueError('Entra discovery must use the selected tenant-specific v2 issuer')
    endpoints = {name: https_endpoint(discovery[name])
                 for name in ('authorization_endpoint', 'token_endpoint', 'jwks_uri')}
    if any(urlsplit(value).netloc != urlsplit(issuer).netloc for value in endpoints.values()):
        raise ValueError('review cross-origin Entra discovery endpoints before preparation')
    principals = {role: sorted({canonical_uuid(value) for value in values})
                  for role, values in [('member', members), ('admin', admins), ('billed', billed)]}
    owner = canonical_uuid(owner)
    if not principals['member'] or not principals['admin'] or owner not in principals['admin']:
        raise ValueError('explicit member/admin principals and an administrator output owner are required')
    include_artifact, include_media, include_embedding = select_services(
        include_artifact, include_media, retained, include_embedding)
    if (include_media and not principals['billed']) or (principals['billed'] and not include_media):
        raise ValueError('explicit billed principals require selected Media and vice versa')
    redirects = sorted({redirect_uri(value) for value in redirects})
    if not redirects:
        raise ValueError('an explicit application client redirect is required')
    # Reuse the existing installation shape and reviewed private placement selection.
    result = catalog(origin, include_artifact, include_media, include_embedding=include_embedding)
    resource, application_issuer = origin + '/mcp/local', origin + '/oauth'
    result['identityProviders'] = [{'id': 'entra', 'issuer': issuer,
        'jwks': {'source': 'remote', 'jwksUri': endpoints['jwks_uri']},
        'claimMapping': {'subject': 'oid', 'tenant': {'claim': 'tid', 'values': {tenant_id: tenant}}},
        'authorizationEndpoint': endpoints['authorization_endpoint'],
        'tokenEndpoint': endpoints['token_endpoint'], 'metadata': {}}]
    result['authorizationServers'] = [{'id': 'hub', 'issuer': application_issuer,
        'jwks': {'source': 'file', 'path': '/etc/veoveo/hub/authorization-server.jwks.json'},
        'accessTokenKeyId': key_id, 'accessTokenSigningKey': 'access_token_signing_key',
        'identityProvider': 'entra', 'authorizationEndpoint': origin + '/oauth/authorize',
        'tokenEndpoint': origin + '/oauth/token', 'metadata': {}}]
    result['profiles'] = [{'id': 'local', 'identityProvider': 'entra', 'authorizationServer': 'hub',
        'protectedResource': resource, 'policyVersion': policy,
        'authModes': ['oidc_authorization_code_pkce'], 'requiredScopes': ['mcp'], 'metadata': {}}]
    result['authorization']['grants'] = [{'role': role,
        'subject': {'principal': issuer + '#' + subject}, 'tenant': tenant}
        for role, subjects in principals.items() for subject in subjects]
    result['tenants'] = [{'id': tenant, 'title': tenant}]
    result['workContexts'] = [{'id': context, 'tenant': tenant, 'title': context, 'policyRevision': policy,
        'outputPolicy': {'owner': {'kind': 'principal', 'id': issuer + '#' + owner}},
        'memberships': [{'level': 'contributor', 'principals': sorted({issuer + '#' + subject
                         for subjects in principals.values() for subject in subjects})}]}]
    result['policies'] = [{'version': policy, 'rules': []}]
    result['oauthClients'] = [{'id': application_client, 'authorizationServer': 'hub',
        'defaultWorkContext': context, 'invocationMode': 'direct', 'allowedResources': [resource],
        'grantTypes': ['authorization_code_pkce', 'refresh_token'], 'authMethods': ['none'],
        'redirectUris': redirects, 'allowedScopes': ['mcp'], 'metadata': {}}]
    result['oidcClients'] = [{'id': 'entra', 'identityProvider': 'entra', 'authorizationServer': 'hub',
        'allowedResources': [resource], 'clientId': client_id, 'redirectUri': origin + '/oauth/callback',
        'authMethod': 'client_secret_post', 'credentialSecret': 'entra_client_secret',
        'scopes': ['openid', 'profile'], 'metadata': {}}]
    result['secrets'] += [{'id': 'access_token_signing_key', 'source': 'env', 'purpose': 'jwks_private_key',
        'locator': 'VEOVEO_ACCESS_TOKEN_SIGNING_KEY_B64', 'owner': {'kind': 'hub'}, 'metadata': {}},
        {'id': 'entra_client_secret', 'source': 'env', 'purpose': 'oauth_client_secret',
         'locator': 'VEOVEO_IDP_OIDC_CLIENT_SECRET', 'owner': {'kind': 'hub'}, 'metadata': {}}]
    result['nativeUpstreams']['gateway'] = gateway
    if retained is not None:
        # Identity/authority migrations are separate reviewed operations, never a rerun side effect.
        for field in ('identityProviders', 'authorizationServers', 'profiles', 'authorization',
                      'tenants', 'workContexts', 'oauthClients', 'oidcClients', 'secrets'):
            if retained[field] != result[field]:
                raise ValueError('retained Entra identity/authority differs; review migration before regeneration')
        if retained['nativeUpstreams']['gateway'] != gateway:
            raise ValueError('retained native gateway differs; review placement before regeneration')
        result['policies'] = copy.deepcopy(retained['policies'])
    return result


def prepare_entra(options):
    retained = retained_catalog()
    if (retained is not None) != (STATE / 'hub.env').exists():
        raise ValueError('incomplete retained Hub configuration; recover it before preparation')
    discovery = json.loads(Path(options.oidc_discovery_file).read_text())
    expected_issuer = os.environ.get('VEOVEO_IDP_OIDC_ISSUER')
    if not expected_issuer or discovery['issuer'].rstrip('/') != expected_issuer.rstrip('/'):
        raise ValueError('trusted issuer must match the supplied standard discovery document')
    arguments = dict(origin=options.hub_origin, discovery=discovery,
        tenant_id=options.entra_tenant_id, client_id=options.entra_client_id,
        tenant=options.tenant, context=options.work_context, policy=options.policy_version,
        owner=options.owner_object_id, members=options.member_object_id, admins=options.admin_object_id,
        billed=options.billed_object_id, application_client=options.application_client_id,
        redirects=options.client_redirect_uri, gateway=options.native_gateway,
        include_artifact=options.include_artifact, include_media=options.include_media,
        include_embedding=options.include_embedding,
        retained=retained)
    # Validate every public selection and retained authority before creating private material.
    entra_catalog(key_id=(arguments['retained'] or {}).get('authorizationServers', [{}])[0]
                  .get('accessTokenKeyId', 'preparation'), **arguments)
    values = hub_secrets(https_origin(options.hub_origin), hosted=True)
    jwk = authorization_jwk(values['VEOVEO_ACCESS_TOKEN_SIGNING_KEY_B64'])
    prepared = entra_catalog(key_id=jwk['kid'], **arguments)
    private(STATE / 'authorization-server.jwks.json', json.dumps({'keys': [jwk]}, indent=2) + '\n')
    private(STATE / 'hub.json', json.dumps(prepared, indent=2) + '\n')
    print('Prepared owner-only Entra Hub configuration; no identity, database or runtime operations performed.')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--hub-origin', required=True, help='explicit canonical HTTPS Hub origin')
    parser.add_argument('--identity-provider', choices=['keycloak', 'entra'], default='keycloak')
    parser.add_argument('--local-public-client', action='store_true',
                        help='configure only native local human PKCE/refresh and write a candidate catalog')
    parser.add_argument('--installation-root', type=Path, default=ROOT,
                        help='trusted local installation containing the retained Keycloak operator inputs')
    parser.add_argument('--control-plane-file', help='fresh authoritative catalog snapshot for local public-client preparation')
    parser.add_argument('--output-control-plane', help='private candidate path; publish separately through native Hub tooling')
    parser.add_argument('--protected-resource', help='existing exact MCP resource for the local public client')
    parser.add_argument('--oidc-discovery-file', help='trusted standard Entra OIDC discovery JSON')
    parser.add_argument('--entra-tenant-id', default=os.environ.get('VEOVEO_IDP_OIDC_TENANT_ID'))
    parser.add_argument('--entra-client-id', default=os.environ.get('VEOVEO_IDP_OIDC_CLIENT_ID'))
    parser.add_argument('--tenant')
    parser.add_argument('--work-context')
    parser.add_argument('--policy-version')
    parser.add_argument('--owner-object-id')
    parser.add_argument('--member-object-id', action='append', default=[])
    parser.add_argument('--admin-object-id', action='append', default=[])
    parser.add_argument('--billed-object-id', action='append', default=[])
    parser.add_argument('--application-client-id')
    parser.add_argument('--client-redirect-uri', action='append', default=[])
    parser.add_argument('--native-gateway', help='verified private OpenShell HTTPS endpoint, separate from public Hub')
    parser.add_argument('--include-artifact', action='store_true',
                        help='explicitly select the private vv-services/artifact native binding')
    parser.add_argument('--include-media', action='store_true',
                        help='select private vv-services/media, requiring selected Artifact')
    parser.add_argument('--include-embedding', action='store_true',
                        help='select private vv-services/embedding without adding roles or billed risk')
    options = parser.parse_args()
    if options.local_public_client:
        if (options.identity_provider != 'keycloak' or not options.control_plane_file
                or not options.output_control_plane or not options.protected_resource):
            raise ValueError('local public-client preparation requires Keycloak and explicit input/output/resource')
        prepare_local_public(options, root=options.installation_root.resolve())
        return
    os.umask(0o077)
    if options.identity_provider == 'entra':
        required = ['oidc_discovery_file', 'entra_tenant_id', 'entra_client_id', 'tenant',
                    'work_context', 'policy_version', 'owner_object_id', 'application_client_id',
                    'native_gateway']
        if any(not getattr(options, name) for name in required):
            parser.error('Entra requires discovery, tenant/client IDs, installation tenant/context/policy, '
                         'owner, application client and native gateway inputs')
        prepare_entra(options)
        return
    if options.hub_origin.rstrip('/') != HUB_ORIGIN:
        raise ValueError('this local setup requires the reviewed vv-control/hub/http origin on 17670')
    retained = retained_catalog()
    include_artifact, include_media, include_embedding = select_services(
        options.include_artifact, options.include_media, retained, options.include_embedding)
    prepared_catalog = catalog(HUB_ORIGIN, include_artifact, include_media, retained, include_embedding)
    os.umask(0o077)
    STATE.mkdir(mode=0o700, parents=True, exist_ok=True)
    STATE.chmod(0o700)
    installation_ca = ROOT / 'tls/ca/ca.crt'
    ssl.create_default_context(cafile=installation_ca)
    private(STATE / 'installation-ca.crt', installation_ca.read_text())
    hub_secrets(HUB_ORIGIN)
    request = runpy.run_path(str(ROOT / 'identity/provision'))['request']
    identity = json.loads((ROOT / 'state/identity/credentials.json').read_text())
    token = request('/realms/master/protocol/openid-connect/token', 'POST', {
        'grant_type': 'password', 'client_id': 'admin-cli', 'username': identity['adminUsername'],
        'password': identity['adminPassword']}, form=True)['access_token']
    base = '/admin/realms/veoveo'
    scopes = request(base + '/client-scopes', token=token)
    selected = {}
    for name in ['mcp', 'sandbox:write']:
        scope = next((scope for scope in scopes if scope['name'] == name), None)
        if scope is None:
            request(base + '/client-scopes', 'POST', {'name': name, 'protocol': 'openid-connect',
                    'attributes': {'include.in.token.scope': 'true'}}, token)
            scope = next(scope for scope in request(base + '/client-scopes', token=token) if scope['name'] == name)
        if request(base + '/client-scopes/' + scope['id'] + '/protocol-mappers/models', token=token):
            raise ValueError('existing shared OAuth scope has unreviewed mappers')
        if scope.get('attributes', {}).get('include.in.token.scope') != 'true':
            raise ValueError('existing OAuth scope omits its token scope')
        selected[name] = scope['id']
    roles = request(base + '/roles', token=token)
    if not any(role['name'] == 'openshell-user' for role in roles):
        request(base + '/roles', 'POST', {'name': 'openshell-user'}, token)
    for role in (*ROLES, 'billed') if include_media else ROLES:
        subject = configure_client(request, token, role, selected['sandbox:write' if role == 'forwarder' else 'mcp'])
        if role == 'forwarder':
            print('Forwarder subject for native vv-services user membership: ' + subject)
    private(STATE / 'hub.json', json.dumps(prepared_catalog, indent=2) + '\n')
    print('Prepared local identities and owner-only state/openshell/hub files; no workloads or database state changed.')
    print('Verify the actual native exposure equals --hub-origin before application qualification.')


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        raise SystemExit('Hub identity preparation failed (' + type(error).__name__ + '); no credentials printed. Inspect trusted state before retry.') from None
