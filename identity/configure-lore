#!/usr/bin/env python3
"""Provision local direct Lore OIDC clients; secrets stay in private operator state."""
import argparse
import json
import os
from pathlib import Path
import re
import runpy
import secrets
import shlex
import tempfile
import tomllib
import uuid

ROOT = Path(__file__).resolve().parent.parent
ISSUER = 'https://auth.localhost:8443/realms/veoveo'
AUDIENCE = 'lores://vv-lore.internal:41337'
SMOKE_REPOSITORY_ID = '01a13b791bca7fe182896b5cbc1b56a5'


def private_write(path, value):
    """Atomically publish trusted state without a permissive intermediate file."""
    with tempfile.NamedTemporaryFile(mode='w', dir=path.parent, delete=False) as output:
        temporary = Path(output.name)
        try:
            os.fchmod(output.fileno(), 0o600)
            output.write(value)
            output.flush()
            os.fsync(output.fileno())
            os.replace(temporary, path)
        finally:
            temporary.unlink(missing_ok=True)


def canonical_id(value):
    if not re.fullmatch('[0-9a-f]{32}', value):
        raise ValueError('canonical IDs required')
    return value


def time_request(options, previous):
    """A no-branch rerun must retain an already finalized assignment."""
    repository = canonical_id(options.repository_id)
    if repository == SMOKE_REPOSITORY_ID:
        raise ValueError('Time must not reuse the smoke repository')
    if options.client_id in {'lore-cli', 'vv-lore-smoke', 'vv-lore-a', 'vv-lore-b', 'vv-lore-detach', 'vv-lore-protected', 'vv-lore-human'}:
        raise ValueError('reserved fixture or public client ID')
    if not re.fullmatch('[a-zA-Z0-9._-]{1,128}', options.client_id):
        raise ValueError('invalid client ID')
    for role, client in previous.items():
        if role != 'time' and (client['clientId'] == options.client_id or client['repository'] == repository):
            raise ValueError('Time must not reuse a fixture client or repository')
    saved = previous.get('time')
    if saved and (saved['clientId'] != options.client_id or saved['repository'] != repository):
        raise ValueError('existing Time identity is immutable')
    branch = options.assigned_branch_id
    if branch is not None:
        canonical_id(branch)
    elif saved:
        branch = saved['branch']
    return [('time', repository, branch, options.client_id)]


def render_assignments(server, clients):
    """Change only explicitly assigned subjects, retaining every other binding."""
    original = tomllib.loads(server)
    assignments = original.get('hooks', {}).get('factory_branch', {}).get('assignments', {})
    for identity in clients.values():
        if identity['branch'] is None:
            continue
        subject = identity['subject']
        if str(uuid.UUID(subject)) != subject:
            raise ValueError('canonical subject UUID required')
        canonical_id(identity['repository'])
        canonical_id(identity['branch'])
        desired = {'repository': identity['repository'], 'branch': identity['branch']}
        previous = assignments.get(subject)
        if previous == desired:
            continue
        header = f'[hooks.factory_branch.assignments."{subject}"]'
        stanza = header + '\nrepository = "' + desired['repository'] + '"\nbranch = "' + desired['branch'] + '"\n'
        if previous is None:
            if not assignments:
                # An empty inline table cannot subsequently be extended in TOML.
                lines = []
                in_hook = False
                for line in server.splitlines(keepends=True):
                    if line.startswith('['):
                        in_hook = line.strip() == '[hooks.factory_branch]'
                    if in_hook and re.fullmatch(r'assignments\s*=\s*\{\}\s*', line):
                        continue
                    lines.append(line)
                server = ''.join(lines)
            server += '\n' + stanza
        else:
            if set(previous) != {'repository', 'branch'}:
                raise ValueError('unrecognized trusted assignment; review before changing')
            pattern = r'(?m)^' + re.escape(header) + r'[^\n]*\n(?:(?!^\[).*(?:\n|$))*'
            server, count = re.subn(pattern, lambda _: stanza + '\n', server)
            if count != 1:
                raise ValueError('unrecognized trusted assignment syntax; review before changing')
    final = tomllib.loads(server)['hooks']['factory_branch']['assignments']
    for subject, value in assignments.items():
        if not any(item['subject'] == subject and item['branch'] is not None for item in clients.values()):
            if final.get(subject) != value:
                raise ValueError('unrelated assignment changed')
    return server


def client_configuration(previous, public, client_id):
    """Retain enabled state and unrelated metadata; never touch role mappings."""
    return {**previous, 'clientId': client_id, 'protocol': 'openid-connect', 'enabled': previous.get('enabled', True), 'publicClient': public,
                  'standardFlowEnabled': public, 'serviceAccountsEnabled': not public,
                  'directAccessGrantsEnabled': False, 'implicitFlowEnabled': False, 'fullScopeAllowed': False,
                  'redirectUris': ['http://127.0.0.1/callback'] if public else [],
                  'attributes': {**previous.get('attributes', {}), 'access.token.lifespan': '300', 'access.token.header.type.rfc9068': 'true',
                                 'client_credentials.use_refresh_token': 'false', 'pkce.code.challenge.method': 'S256'}}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--fixture', default='state/openshell/factory-hook-fixture.json')
    parser.add_argument('--client-id', help='dedicated real Time repository client; requires --repository-id')
    parser.add_argument('--repository-id', help='exact real Time repository ID, not a fixture ID')
    parser.add_argument('--assigned-branch-id', help='finalize trusted Time factory branch after initial publishing')
    options = parser.parse_args()
    os.umask(0o077)
    if bool(options.client_id) != bool(options.repository_id):
        parser.error('--client-id and --repository-id are required together')
    if options.assigned_branch_id and not options.client_id:
        parser.error('--assigned-branch-id requires named Time provisioning')
    directory = ROOT / 'state/openshell/lore-direct'
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    directory.chmod(0o700)
    config_path = directory / 'config.json'
    config = json.loads(config_path.read_text()) if config_path.exists() else {}
    if config and (config['issuer'] != ISSUER or config['audience'] != AUDIENCE):
        raise ValueError('existing issuer or audience differs')
    clients = dict(config.get('clients', {}))
    server_path = directory / 'server.toml'
    server = server_path.read_text() if server_path.exists() else (ROOT / 'lore/server.toml').read_text()
    # Validate trusted configuration before touching the issuer.
    tomllib.loads(server)
    if options.client_id:
        roles = time_request(options, clients)
        repositories = [roles[0][1]]
    else:
        fixture = json.loads((ROOT / options.fixture).read_text())
        smoke_repo = SMOKE_REPOSITORY_ID
        for value in [fixture[key] for key in ['repository', 'assigned', 'main', 'other', 'forbidden']] + [smoke_repo]:
            canonical_id(value)
        roles = [(role, repository, branch, 'vv-lore-' + role) for role, repository, branch in [
            ('smoke', smoke_repo, None), ('a', fixture['repository'], fixture['assigned']),
            ('b', fixture['repository'], fixture['other']), ('detach', fixture['repository'], fixture['assigned']),
            ('protected', fixture['repository'], fixture['main']), ('human', fixture['repository'], None)]]
        roles.append(('public', None, None, 'lore-cli'))
        repositories = [fixture['repository'], smoke_repo]
        config['fixture'] = fixture
    request = runpy.run_path(str(ROOT / 'identity/provision'))['request']
    identity = json.loads((ROOT / 'state/identity/credentials.json').read_text())
    token = request('/realms/master/protocol/openid-connect/token', 'POST', {
        'grant_type': 'password', 'client_id': 'admin-cli',
        'username': identity['adminUsername'], 'password': identity['adminPassword']}, form=True)['access_token']
    base = '/admin/realms/veoveo'
    scopes = request(base + '/client-scopes', token=token)
    basic = next(scope for scope in scopes if scope['name'] == 'basic')
    scope_ids = {}
    for repository in repositories:
        name = 'lore-repo-' + repository
        scope = next((scope for scope in scopes if scope['name'] == name), None)
        if scope is None:
            request(base + '/client-scopes', 'POST', {'name': name, 'protocol': 'openid-connect',
                    'attributes': {'include.in.token.scope': 'true'}}, token)
            scope = next(scope for scope in request(base + '/client-scopes', token=token) if scope['name'] == name)
        scope_ids[repository] = scope['id']
        desired = [
            {'name': 'lore-audience', 'protocol': 'openid-connect', 'protocolMapper': 'oidc-audience-mapper',
             'config': {'included.custom.audience': AUDIENCE, 'access.token.claim': 'true', 'id.token.claim': 'false', 'userinfo.token.claim': 'false'}},
            {'name': 'lore-repository', 'protocol': 'openid-connect', 'protocolMapper': 'oidc-hardcoded-claim-mapper',
             'config': {'claim.name': 'resources', 'claim.value': json.dumps([{'resource_id': 'urc-' + repository, 'permission': []}]),
                        'jsonType.label': 'JSON', 'access.token.claim': 'true', 'id.token.claim': 'false', 'userinfo.token.claim': 'false', 'access.tokenResponse.claim': 'false'}}]
        mapper_path = base + '/client-scopes/' + scope['id'] + '/protocol-mappers/models'
        existing = request(mapper_path, token=token)
        for mapper in desired:
            previous = next((item for item in existing if item['name'] == mapper['name']), None)
            if previous:
                request(mapper_path + '/' + previous['id'], 'PUT', mapper, token)
            else:
                request(mapper_path, 'POST', mapper, token)
    changed_clients = {}
    for role, repository, branch, client_id in roles:
        public = role == 'public'
        matches = request(base + '/clients?clientId=' + client_id, token=token)
        if len(matches) > 1:
            raise ValueError('ambiguous client registration')
        previous = request(base + '/clients/' + matches[0]['id'], token=token) if matches else {}
        if previous and (previous.get('publicClient', False) != public or previous.get('protocol') != 'openid-connect'):
            raise ValueError('existing client has a different authentication contract')
        saved = clients.get(role)
        old_subject = request(base + '/clients/' + matches[0]['id'] + '/service-account-user', token=token)['id'] if matches and not public else None
        if saved and (not matches or saved['subject'] != old_subject or saved['clientId'] != client_id):
            raise ValueError('existing client identity changed')
        path = directory / (role + '.secret')
        if not public and not path.exists():
            # Preserve the native existing client secret when adopting a registration.
            value = request(base + '/clients/' + matches[0]['id'] + '/client-secret', token=token)['value'] if matches else secrets.token_urlsafe(36)
            private_write(path, value + '\n')
        if not public and matches:
            actual = request(base + '/clients/' + matches[0]['id'] + '/client-secret', token=token)['value']
            if not secrets.compare_digest(path.read_text().strip(), actual):
                raise ValueError('client secret differs; refusing rotation')
        client = client_configuration(previous, public, client_id)
        # Existing role mappings are not rewritten. No role client-scope is linked.
        if not public:
            path.chmod(0o600)
            client['secret'] = path.read_text().strip()
        if matches:
            key = matches[0]['id']
            request(base + '/clients/' + key, 'PUT', client, token)
        else:
            request(base + '/clients', 'POST', client, token)
            key = request(base + '/clients?clientId=' + client_id, token=token)[0]['id']
        # Explicit links: no realm-default claims, roles, offline access or other repos.
        desired = {'default': {basic['id']}, 'optional': set() if public else {scope_ids[repository]}}
        for kind, wanted in desired.items():
            link = base + '/clients/' + key + '/' + kind + '-client-scopes'
            current = {scope['id'] for scope in request(link, token=token)}
            for scope_id in current - wanted:
                request(link + '/' + scope_id, 'DELETE', token=token)
            for scope_id in wanted - current:
                request(link + '/' + scope_id, 'PUT', token=token)
        if not public:
            subject = request(base + '/clients/' + key + '/service-account-user', token=token)['id']
            if old_subject is not None and subject != old_subject:
                raise ValueError('client subject changed')
            if not options.client_id and branch is not None:
                binding = tomllib.loads(server).get('hooks', {}).get('factory_branch', {}).get('assignments', {}).get(subject)
                if binding and binding != {'repository': repository, 'branch': branch}:
                    raise ValueError('existing fixture assignment differs; preserve trusted state')
            if branch is None or (role == 'time' and options.assigned_branch_id is None):
                binding = tomllib.loads(server).get('hooks', {}).get('factory_branch', {}).get('assignments', {}).get(subject)
                if binding:
                    if binding['repository'] != repository or (branch is not None and branch != binding['branch']):
                        raise ValueError('existing assignment differs; review trusted state')
                    branch = binding['branch']
            clients[role] = {'clientId': client_id, 'clientKey': key, 'subject': subject, 'secretFile': str(path),
                             'repository': repository, 'branch': branch, 'scope': 'lore-repo-' + repository}
            changed_clients[role] = clients[role]
    config.update({'issuer': ISSUER, 'audience': AUDIENCE, 'tokenUrl': ISSUER + '/protocol/openid-connect/token',
                   'clients': clients, 'tokenLifetimeSeconds': 300, 'refreshBeforeSeconds': 180,
                   'verifierLeewaySeconds': 60})
    server = render_assignments(server, changed_clients)
    private_write(server_path, server)
    private_write(config_path, json.dumps(config, indent=2) + '\n')
    if options.client_id:
        private_write(directory / 'time.refresh.env',
                      'VV_LORE_TIME_CLIENT_ID=' + shlex.quote(options.client_id) + '\n' +
                      'VV_LORE_TIME_CLIENT_SECRET=' + shlex.quote((directory / 'time.secret').read_text().strip()) + '\n')
        profile = (ROOT / 'openshell/providers/lore-time.example.yaml').read_text().replace('REPOSITORY_ID', options.repository_id)
        private_write(directory / 'time.provider.yaml', profile)
    print('Configured direct Lore OIDC clients, optional repository scopes and trusted subjects; no secrets printed')


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        raise SystemExit(f'Lore OIDC provisioning failed ({type(error).__name__}); credentials were not printed') from None
