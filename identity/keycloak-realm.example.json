{
  "realm": "veoveo",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      {
        "name": "administrator",
        "description": "Installation administration: the Hub policy rule installation-administration names it"
      }
    ],
    "client": {
      "openshell": [
        {"name": "openshell-admin"},
        {"name": "openshell-user"},
        {"name": "config:read"},
        {"name": "workspace:read"},
        {"name": "workspace:write"},
        {"name": "sandbox:read"},
        {"name": "sandbox:write"},
        {"name": "provider:read"},
        {"name": "provider:write"}
      ]
    }
  },
  "groups": [
    {
      "name": "openshell-operators",
      "clientRoles": {
        "openshell": [
          "openshell-admin",
          "config:read",
          "workspace:read",
          "workspace:write",
          "sandbox:read",
          "sandbox:write",
          "provider:read",
          "provider:write"
        ]
      }
    }
  ],
  "clients": [
    {
      "clientId": "openshell",
      "name": "OpenShell gateway",
      "description": "The audience of the gateway's management API; its roles are the gateway's roles and scopes",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "hub-broker",
      "name": "Veoveo",
      "description": "Hub's authorization-code broker: people sign in to Hub through it",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${VEOVEO_KEYCLOAK_HUB_BROKER_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": ["https://veoveo.example.com/oauth/callback"],
      "webOrigins": [],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "tenant",
            "claim.value": "reference",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "hub-native-control",
      "name": "Hub native control",
      "description": "Hub's client-credentials identity at the OpenShell gateway, renewed in OpenShell custody",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${VEOVEO_KEYCLOAK_HUB_NATIVE_CONTROL_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "openshell-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "openshell",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "openshell-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "usermodel.clientRoleMapping.clientId": "openshell",
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "openshell-cli",
      "name": "OpenShell command line",
      "description": "Operators sign in to the gateway with the openshell command line",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": ["http://127.0.0.1/callback", "http://127.0.0.1:80/callback"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "openshell-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "openshell",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "openshell-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "usermodel.clientRoleMapping.clientId": "openshell",
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-hub-native-control",
      "enabled": true,
      "serviceAccountClientId": "hub-native-control",
      "clientRoles": {
        "openshell": [
          "openshell-admin",
          "config:read",
          "workspace:read",
          "workspace:write",
          "sandbox:read",
          "sandbox:write",
          "provider:read",
          "provider:write"
        ]
      }
    }
  ]
}
